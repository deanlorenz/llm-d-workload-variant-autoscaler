# hack/benchmark/.env.sample — copy to hack/benchmark/.env and fill in.
#
# The Makefile `-include`s hack/benchmark/.env near the top, so every KEY=value
# below becomes a make variable that `benchmark-standup` / `benchmark-add-variant`
# substitute into the copied scenario YAML and the add_variant.py flags.
#
# §2a discipline: environment-specific values carry NO baked-in defaults in the
# committed guide scenarios — they live only here. `benchmark-standup` errors
# loudly if a required one is unset. `.env` itself is gitignored; only this
# sample is committed.

# ── Tier A: controller under test (the :ta-0.9 seam; deferrable) ──────────────
# The KEDA path installs the controller from source via kustomize, so THIS image
# is the real pin under test — not the helm chart version below.
WVA_IMAGE_REPO=quay.io/deanlorenz/llm-d-workload-variant-autoscaler
WVA_IMAGE_TAG=ta-0.9

# ── Cluster / environment ─────────────────────────────────────────────────────
BENCHMARK_NAMESPACE=dhl-wva-209
# Node GPU accelerator label — WVA needs this to resolve k1/k2 and emit
# accelerator-specific saturation metrics (else accelerator_type="unresolved").
ACCELERATOR_NAME=NVIDIA-H100-80GB-HBM3
# Prometheus/Thanos endpoint for KEDA ScaledObject triggers.
PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
# Model under test. BENCHMARK_MODEL_ID is the full HF id (name / path /
# huggingfaceId); BENCHMARK_MODEL_SHORTNAME is its resource-name slug (lowercase,
# '/' and '.' → '-') — set both consistently (no auto-derivation, per §2a).
BENCHMARK_MODEL_ID=unsloth/Meta-Llama-3.1-8B-Instruct
BENCHMARK_MODEL_SHORTNAME=unsloth-meta-llama-3-1-8b-instruct
# Prometheus-operator release label the scenario's PodMonitor selects on.
PROM_RELEASE_LABEL=llmd
# Harness scratch dir on the runner host (set per scenario/run).
WVA_WORKDIR=~/data/wva-benchmark

# ── Image pins ────────────────────────────────────────────────────────────────
# NOTE: docker.io conflicts with AGENTS.md ("no docker.io images"); point
# VLLM_IMAGE_REPO at a fully-qualified mirror (quay.io/registry.k8s.io) before
# any e2e use. Left as #1435's default for now — decision deferred to Dean.
VLLM_IMAGE_REPO=docker.io/vllm/vllm-openai
VLLM_IMAGE_TAG=v0.14.0
# Helm chart versions (Ofer's chart — may predate PR #1341's KEDA RBAC; the
# kustomize-from-source controller image above is what's actually under test).
WVA_CHART_VERSION=0.8.0-rc5
PROMETHEUS_ADAPTER_CHART_VERSION=5.2.0

# ── DEPRECATED: per-variant cost/min/max now live in the VARIANT_CONFIG yaml ──
# `benchmark-configure-variants` reads variantCost / minReplicas / maxReplicas
# from each entry in the variant-set yaml (see hack/benchmark/scenarios/guides/
# variants/*.yaml). These env values are no longer consumed and can be removed.
#PRIMARY_COST=10.0
#PRIMARY_MIN=1
#PRIMARY_MAX=10