# armB — anchor controller WITH the second anchor PR. Treatment arm of the A/B.
#
# ⚠ PRIVATE TO THIS BRANCH — MUST NOT REACH UPSTREAM.
# This file names one operator's namespace, cluster context, and personal quay
# repo. It is campaign state, not project content: upstream tracks no .env file
# of any kind, and a hardcoded namespace in a shared repo is an invitation to
# deploy into someone else's space. It lives here only so this A/B is
# reproducible on the private fork. If a change in this directory is ever
# proposed upstream, this file and armA.env are not part of it.
#
# This file is the reproducible record of what arm A ran. Everything the run
# depends on is stated here explicitly; nothing is taken from a command-line
# override. If you override something anyway, env-guard will say so, loudly, and
# this file stops being a complete record.
#
# Arm A is armA.env and differs ONLY in WVA_IMAGE_TAG. Keep every other value
# identical between the two files -- that single difference is the experiment.

# Cluster this file is for. env-guard refuses to run if the live kube context is
# not this one, which is what stops a stale context from writing into the wrong
# cluster.
KUBE_CONTEXT=dhl-wva-209/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com

BENCHMARK_REPO_URL=git@github.com:deanlorenz/llm-d-benchmark.git
BENCHMARK_REPO_REF=wva-ta-benchmark
BENCHMARK_SPEC=guides/two-variant-wva

# ── The variable under test ───────────────────────────────────────────────────
# Arm B: the anchor refactor WITH the second anchor PR.
WVA_IMAGE_REPO=quay.io/deanlorenz/llm-d-workload-variant-autoscaler
WVA_IMAGE_TAG=ta-0.9-anchor-pr2-20260809

# ── Everything below must match armA.env exactly ──────────────────────────────
BENCHMARK_NAMESPACE=dhl-wva-209
ACCELERATOR_NAME=NVIDIA-H100-80GB-HBM3
PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
BENCHMARK_MODEL_ID=unsloth/Meta-Llama-3.1-8B-Instruct
BENCHMARK_MODEL_SHORTNAME=unsloth-meta-llama-3-1-8b-instruct
PROM_RELEASE_LABEL=llmd
WVA_WORKDIR=~/data/wva-benchmark
VLLM_IMAGE_REPO=docker.io/vllm/vllm-openai
VLLM_IMAGE_TAG=v0.20.2
HARNESS_IMAGE_REPO=ghcr.io/llm-d/llm-d-benchmark
HARNESS_IMAGE_TAG=v0.6.7
WVA_CHART_VERSION=0.8.0-rc5
PROMETHEUS_ADAPTER_CHART_VERSION=5.2.0
BENCHMARK_SKIP_PROMETHEUS_ADAPTER=true
PRIMARY_COST=10.0
PRIMARY_MIN=1
PRIMARY_MAX=10
