# m-ta-prefill-knee — probes the ITL prefill term in isolation.
#
# ⚠ PRIVATE TO THIS BRANCH — MUST NOT REACH UPSTREAM.
# Names one operator's namespace, cluster context and personal quay repo.
#
# Profile: ta_prefill_knee.yaml.in -- short-output (~100 tok), prefill-dominated
# shape (see that file's own header for why the campaign's other profiles are
# NOT prefill-heavy despite the name, and the sizing math for its 20Gi PVC
# requirement). TA only, matching the profile's own stated purpose (isolating
# TA's ITL model, not the sat+TA comparison the campaign matrix ran).
#
# The analyzer set is recorded here rather than passed on the command line: the
# file has to be a complete record of what ran, and a value supplied at the
# prompt would leave no trace in the results.

KUBE_CONTEXT=dhl-wva-209/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com

BENCHMARK_REPO_URL=git@github.com:deanlorenz/llm-d-benchmark.git
BENCHMARK_REPO_REF=wva-ta-benchmark
BENCHMARK_SPEC=guides/two-variant-wva

WVA_IMAGE_REPO=quay.io/deanlorenz/llm-d-workload-variant-autoscaler
WVA_IMAGE_TAG=ta-0.9-anchor-pr2-20260809

BENCHMARK_NAMESPACE=dhl-wva-209
ACCELERATOR_NAME=NVIDIA-H100-80GB-HBM3
PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
BENCHMARK_MODEL_ID=unsloth/Meta-Llama-3.1-8B-Instruct
BENCHMARK_MODEL_SHORTNAME=unsloth-meta-llama-3-1-8b-instruct
PROM_RELEASE_LABEL=llmd
WVA_WORKDIR=~/data/wva-benchmark
VLLM_IMAGE_REPO=docker.io/vllm/vllm-openai
VLLM_IMAGE_TAG=v0.20.2
HARNESS_IMAGE_REPO=ghcr.io/llm-d/llm-d-benchmark
HARNESS_IMAGE_TAG=v0.6.7
WVA_CHART_VERSION=0.8.0-rc5
PROMETHEUS_ADAPTER_CHART_VERSION=5.2.0
BENCHMARK_SKIP_PROMETHEUS_ADAPTER=true
PRIMARY_COST=10.0
PRIMARY_MIN=1
PRIMARY_MAX=10

# ── Matrix axes ───────────────────────────────────────
WVA_ANALYZERS=throughput
BENCHMARK_PROFILE=ta_prefill_knee.yaml
BENCHMARK_HARNESS=inference-perf
