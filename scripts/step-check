#!/usr/bin/env bash
# step-check — post-step gate. Replaces a human eyeballing every write with a
# mechanical check, run once a coder believes a step is finished.
#
#   step-check --scope <path> [--scope <path> ...] --lineage code|plans
#               [--allow-untracked <glob>]...
#               [--ledger <file> --step <id> [--handoffs-dir <dir>]]
#
# Scope containment: a changed path is in scope if it equals a declared
# --scope path exactly, or sits beneath a declared --scope directory — a
# path-prefix match on normalised paths, never a glob. "Changed" means
# modified, staged, and untracked: an untracked file outside scope is exactly
# the drift this exists to catch, so it counts the same as a tracked edit.
# Bias is toward refusal, deliberately: anything this script cannot place
# inside scope counts as outside it, and a --scope list with nothing in it is
# refused outright rather than treated as "everything is permitted" — an
# empty scope is a spec defect, not a grant.
#
# Sign-off policy: the two lineages have opposite rules, so --lineage has no
# default — an unspecified or unrecognised value is a usage error, never a
# guess. code requires Signed-off-by on the tip commit (HEAD); plans forbids
# it. Checked by scanning HEAD's commit message body for a line starting
# `Signed-off-by:`, the same signal `git commit -s`/`--signoff` write and the
# same one CONVENTIONS.md's own pre-push checklist greps for. A caller with
# no obvious source for --lineage can default it from the branch name: this
# worktree's own convention is that the plans lineage is the literal branch
# `plans` (an orphan) plus any branch built to feed it (e.g. `plans-tooling`,
# built as its own orphan and later copied in rather than merged), and every
# other branch is a code branch — see CONVENTIONS.md § Repository Layout.
# On a pass, the rule that was applied is reported so a clean run says what
# it checked, not only that it passed — but only once the *whole* invocation
# is otherwise clean: a run that also fails scope containment stays silent on
# this point rather than mixing a success note into a failure report.
#
# Judgment mark (Addendum 1's proceed-and-mark obligations): --ledger <file>
# is the coder's own session/status/<branch>.md, read for two line shapes
# (everything else in that file is prose this script ignores):
#
#   S<n> · commit <sha> · verify pass · <one line>       (ordinary step work)
#   S<n> · judgment <slug> · <ambiguous/assumed/why/revert/decision prose>
#
# --step <id> names which step this invocation is for (required together
# with --ledger — the ledger accumulates across a whole run, and "at this
# step" in the spec means only that step's own judgments are checked
# forward; not in the Intent block's abbreviated call-stack diagram, added
# here the same way --ledger itself was). Omitting --ledger skips every
# judgment check and says so on stderr — silence would let a caller believe
# they ran. Passing --step without --ledger is accepted and ignored.
#
# For each `judgment <slug>` entry naming --step's id:
#   1. a tag `judgment/<branch>/<step>-<slug>` (branch via `git branch
#      --show-current`) must exist and resolve to a commit — missing is 40.
#   2. isolation: that commit's own changed paths (`git diff-tree --root`)
#      must all be in scope, exactly like the scope-containment check above
#      — and it must differ from every `commit <sha>` this ledger records
#      for the same step, since a judgment sharing a commit with required
#      work cannot be reverted without losing the work. No such `commit`
#      line at all means isolation cannot be established either — this
#      script never reports "isolated" without having checked it, so that
#      case is refused too. Either failure is 41.
#   3. surfacing: some `--handoffs-dir`/spec__*.md file's body must mention
#      the slug as a whole token ([^a-z0-9-] or an edge on both sides,
#      case-sensitive — the citation rule conv-rename's own S3 already
#      established for this exact "conventions manifest or prose mention"
#      shape). Absent is 42; this script cannot judge whether the content
#      is adequate, only whether a match exists.
# --handoffs-dir defaults per lineage, matching where a coder's write scope
# actually puts these handoffs (CODER-CONVENTIONS.md §5.2): `plans` writes
# session/handoffs/ in its own tree; every other (code) branch is a sibling
# worktree of plans/, so the default is ../plans/session/handoffs. Override
# for anything else, tests included.
#
# The reverse direction, independent of --step: every `judgment/<branch>/*`
# tag must have a matching `judgment <slug>` ledger line for *some* step (any
# step already checked in an earlier invocation still counts) — a tag with
# none is 43, an unlogged judgment, which the spec calls worse than an
# unmarked one because nothing about it is even visible without the tag
# inventory.
#
# Exit codes are the contract, and are additive across this spec's steps:
#   0   clean
#   2   usage error (bad arguments, not inside a git working tree, no
#       commits yet, --lineage missing or not code/plans, --ledger given
#       without --step, or --ledger unreadable)
#   20  scope containment: a change landed outside every declared scope path
#   21  scope containment: no --scope was given at all
#   30  sign-off policy: the tip commit violates the declared lineage's rule
#   40  judgment mark: no tag for a ledger-named judgment
#   41  judgment mark: tag not isolated (out-of-scope path, or shares a
#       commit with recorded step work, or isolation cannot be established)
#   42  judgment mark: no handoff surfaces the judgment
#   43  judgment mark: a judgment/* tag has no ledger entry at all
#
# All violations found are reported before exiting; the exit code is the
# lowest-numbered class present, so a caller can branch on the most
# structural failure while stderr still shows everything else.
set -uo pipefail

die() {
    local code=$1
    shift
    printf 'step-check: %s\n' "$*" >&2
    exit "$code"
}

scopes=()
allow_untracked=()
lineage=
ledger=
step=
handoffs_dir=

while [ "$#" -gt 0 ]; do
    case $1 in
        --scope)
            [ "$#" -ge 2 ] || die 2 '--scope needs a path argument'
            scopes+=("$2")
            shift 2
            ;;
        --scope=*)
            scopes+=("${1#--scope=}")
            shift
            ;;
        --lineage)
            [ "$#" -ge 2 ] || die 2 '--lineage needs an argument (code|plans)'
            lineage=$2
            shift 2
            ;;
        --lineage=*)
            lineage=${1#--lineage=}
            shift
            ;;
        --allow-untracked)
            [ "$#" -ge 2 ] || die 2 '--allow-untracked needs a glob argument'
            allow_untracked+=("$2")
            shift 2
            ;;
        --allow-untracked=*)
            allow_untracked+=("${1#--allow-untracked=}")
            shift
            ;;
        --ledger)
            [ "$#" -ge 2 ] || die 2 '--ledger needs a file argument'
            ledger=$2
            shift 2
            ;;
        --ledger=*)
            ledger=${1#--ledger=}
            shift
            ;;
        --step)
            [ "$#" -ge 2 ] || die 2 '--step needs an id argument (e.g. S03)'
            step=$2
            shift 2
            ;;
        --step=*)
            step=${1#--step=}
            shift
            ;;
        --handoffs-dir)
            [ "$#" -ge 2 ] || die 2 '--handoffs-dir needs a directory argument'
            handoffs_dir=$2
            shift 2
            ;;
        --handoffs-dir=*)
            handoffs_dir=${1#--handoffs-dir=}
            shift
            ;;
        -h|--help)
            printf 'usage: step-check --scope <path>... --lineage code|plans [--allow-untracked <glob>]...\n'
            printf '                   [--ledger <file> --step <id> [--handoffs-dir <dir>]]\n'
            exit 0
            ;;
        --*)
            die 2 "unknown option: $1"
            ;;
        *)
            die 2 "unexpected argument: $1"
            ;;
    esac
done

[ -n "$lineage" ] || die 2 '--lineage is required (code|plans); it has no default'
case $lineage in
    code|plans) ;;
    *) die 2 "invalid --lineage value: $lineage (must be code or plans)" ;;
esac

if [ -n "$ledger" ]; then
    [ -n "$step" ] || die 2 '--step is required (e.g. S03) when --ledger is given'
    [ -f "$ledger" ] || die 2 "no such ledger file: $ledger"
    [ -r "$ledger" ] || die 2 "ledger file is not readable: $ledger"
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 2 'not inside a git working tree'
git rev-parse HEAD >/dev/null 2>&1 || die 2 'no commits yet: nothing to check sign-off against'

exit_code=0
note_class() {
    local code=$1
    if [ "$exit_code" -eq 0 ] || [ "$code" -lt "$exit_code" ]; then
        exit_code=$code
    fi
}

# Sign-off policy. The two lineages have opposite rules, so this is a
# direction check against HEAD's own commit message, never a hard-coded
# default. HEAD's body (not just the subject) is scanned for a trailer-shaped
# line, matching how `git commit -s`/`--signoff` write it and how the
# project's own pre-push checklist greps for it.
lineage_note=
tip_has_signoff=0
git log -1 --format=%B HEAD | grep -q '^Signed-off-by:' && tip_has_signoff=1

case $lineage in
    code)
        if [ "$tip_has_signoff" -eq 1 ]; then
            lineage_note='lineage=code: Signed-off-by present on the tip commit, as required'
        else
            printf 'step-check: [30] lineage=code requires Signed-off-by on the tip commit; none found\n' >&2
            note_class 30
        fi
        ;;
    plans)
        if [ "$tip_has_signoff" -eq 0 ]; then
            lineage_note='lineage=plans: no Signed-off-by on the tip commit, as required'
        else
            printf 'step-check: [30] lineage=plans forbids Signed-off-by on the tip commit; one was found\n' >&2
            note_class 30
        fi
        ;;
esac

# Strip a leading ./ and any trailing /. Two scope arguments that normalise to
# the same string are harmless duplicates, not an error. plan-lint reads this
# same rule when it later validates a spec's own scope: fields, so a change
# here is a change there too.
normalise() {
    local p=$1
    p=${p#./}
    while [ "${#p}" -gt 1 ] && [ "${p: -1}" = / ]; do
        p=${p%/}
    done
    printf '%s' "$p"
}

if [ "${#scopes[@]}" -eq 0 ]; then
    printf 'step-check: [21] empty scope list refused: an empty scope is a spec defect, not permission\n' >&2
    note_class 21
fi

norm_scopes=()
for s in "${scopes[@]}"; do
    norm_scopes+=("$(normalise "$s")")
done

in_scope() {
    local path=$1 s
    for s in "${norm_scopes[@]}"; do
        [ "$path" = "$s" ] && return 0
        case $path in
            "$s"/*) return 0 ;;
        esac
    done
    return 1
}

is_allowed_untracked() {
    local path=$1 g
    for g in ${allow_untracked+"${allow_untracked[@]}"}; do
        # A caller-supplied glob is matched with shell pattern rules, not
        # regex — consistent with every --allow-untracked example in the
        # spec being a plain */ext shape.
        # shellcheck disable=SC2254
        case $path in
            $g) return 0 ;;
        esac
    done
    return 1
}

offenders=()

# An empty scope has already been refused above (class 21); skip the drift
# scan rather than let every changed path double-report as an offender too.
if [ "${#scopes[@]}" -gt 0 ]; then
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        status=${line:0:2}
        rest=${line:3}
        # A rename/copy entry carries "old -> new"; both sides count as
        # changed, since either one landing outside scope is drift.
        case $rest in
            *' -> '*)
                paths=("${rest%% -> *}" "${rest#* -> }")
                ;;
            *)
                paths=("$rest")
                ;;
        esac
        for path in "${paths[@]}"; do
            path=$(normalise "$path")
            in_scope "$path" && continue
            if [ "$status" = '??' ] && is_allowed_untracked "$path"; then
                continue
            fi
            offenders+=("$path")
        done
    done < <(git status --porcelain=v1)
fi

if [ "${#offenders[@]}" -gt 0 ]; then
    printf 'step-check: [20] change outside declared scope: %s\n' "${offenders[@]}" >&2
    note_class 20
fi

# Judgment mark. --ledger is optional; skip and announce rather than run
# silently, so a caller cannot mistake "no flag" for "checked and clean".
if [ -z "$ledger" ]; then
    printf 'step-check: --ledger not given; judgment-mark checks skipped\n' >&2
else
    branch=$(git branch --show-current)
    [ -n "$branch" ] || die 2 'cannot determine current branch (detached HEAD?); judgment tags are branch-scoped'

    if [ -z "$handoffs_dir" ]; then
        if [ "$lineage" = plans ]; then
            handoffs_dir=session/handoffs
        else
            handoffs_dir=../plans/session/handoffs
        fi
    fi

    # One pass over the ledger, in file order. Every other line in a real
    # session/status/<branch>.md (identity block, notes, snapshot header) is
    # prose this does not recognise and silently ignores.
    ledger_records=$(awk '
        /^S[0-9]+ · commit / {
            line = $0
            s = line; sub(/ .*/, "", s)
            rest = line; sub(/^S[0-9]+ · commit /, "", rest)
            sha = rest; sub(/[^A-Za-z0-9].*/, "", sha)
            if (sha != "") printf "COMMIT\t%s\t%s\n", s, sha
            next
        }
        /^S[0-9]+ · judgment / {
            line = $0
            s = line; sub(/ .*/, "", s)
            rest = line; sub(/^S[0-9]+ · judgment /, "", rest)
            slug = rest; sub(/[^a-z0-9-].*/, "", slug)
            if (slug != "") printf "JUDGMENT\t%s\t%s\n", s, slug
            next
        }
    ' "$ledger")

    declare -a commit_step=() commit_sha=()
    declare -a judgment_step=() judgment_slug=()
    while IFS=$'\t' read -r kind f1 f2; do
        [ -n "$kind" ] || continue
        case $kind in
            COMMIT)   commit_step+=("$f1");   commit_sha+=("$f2")  ;;
            JUDGMENT) judgment_step+=("$f1"); judgment_slug+=("$f2") ;;
        esac
    done <<<"$ledger_records"

    # Forward: every ledger judgment named for --step must have an isolated,
    # tagged, surfaced commit.
    if [ -n "$step" ]; then
        for i in "${!judgment_step[@]}"; do
            [ "${judgment_step[$i]}" = "$step" ] || continue
            slug=${judgment_slug[$i]}
            tag="judgment/$branch/$step-$slug"

            tag_sha=$(git rev-list -n1 "$tag" -- 2>/dev/null)
            if [ -z "$tag_sha" ]; then
                printf 'step-check: [40] judgment %s/%s: no tag matching %s\n' "$step" "$slug" "$tag" >&2
                note_class 40
                continue
            fi

            isolated=1

            changed=()
            while IFS= read -r p; do
                [ -n "$p" ] && changed+=("$p")
            done < <(git diff-tree --no-commit-id --name-only -r --root "$tag_sha" 2>/dev/null)
            for p in "${changed[@]}"; do
                p=$(normalise "$p")
                in_scope "$p" && continue
                printf 'step-check: [41] judgment %s/%s: tagged commit touches a path outside scope: %s\n' \
                    "$step" "$slug" "$p" >&2
                isolated=0
            done

            step_work_shas=()
            for i2 in "${!commit_step[@]}"; do
                [ "${commit_step[$i2]}" = "$step" ] && step_work_shas+=("${commit_sha[$i2]}")
            done
            if [ "${#step_work_shas[@]}" -eq 0 ]; then
                printf 'step-check: [41] judgment %s/%s: no ordinary-work commit recorded for step %s; cannot confirm isolation\n' \
                    "$step" "$slug" "$step" >&2
                isolated=0
            else
                for w in "${step_work_shas[@]}"; do
                    if [ "$w" = "$tag_sha" ]; then
                        printf 'step-check: [41] judgment %s/%s: tag points at the same commit recorded as step %s work; a judgment cannot share a commit with required work\n' \
                            "$step" "$slug" "$step" >&2
                        isolated=0
                    fi
                done
            fi
            [ "$isolated" -eq 1 ] || note_class 41

            surfaced=0
            if [ -d "$handoffs_dir" ]; then
                shopt -s nullglob
                spec_handoffs=("$handoffs_dir"/spec__*.md)
                shopt -u nullglob
                for f in ${spec_handoffs+"${spec_handoffs[@]}"}; do
                    grep -qE "(^|[^a-z0-9-])$slug([^a-z0-9-]|\$)" "$f" 2>/dev/null && surfaced=1
                done
            fi
            if [ "$surfaced" -eq 0 ]; then
                printf 'step-check: [42] judgment %s/%s: no %s/spec__*.md names this judgment\n' \
                    "$step" "$slug" "$handoffs_dir" >&2
                note_class 42
            fi
        done
    fi

    # Reverse: any judgment/<branch>/* tag on this branch must have a
    # matching ledger entry for some step — an unlogged judgment tag is its
    # own violation, worse than an unmarked one.
    while IFS= read -r tag; do
        [ -n "$tag" ] || continue
        rest=${tag#"judgment/$branch/"}
        [ "$rest" != "$tag" ] || continue
        tag_step=${rest%%-*}
        tag_slug=${rest#"$tag_step"-}
        logged=0
        for i in "${!judgment_step[@]}"; do
            if [ "${judgment_step[$i]}" = "$tag_step" ] && [ "${judgment_slug[$i]}" = "$tag_slug" ]; then
                logged=1
                break
            fi
        done
        if [ "$logged" -eq 0 ]; then
            printf 'step-check: [43] tag %s has no matching ledger entry (unlogged judgment)\n' "$tag" >&2
            note_class 43
        fi
    done < <(git tag -l "judgment/$branch/*")
fi

if [ "$exit_code" -eq 0 ] && [ -n "$lineage_note" ]; then
    printf 'step-check: %s\n' "$lineage_note"
fi

exit "$exit_code"
