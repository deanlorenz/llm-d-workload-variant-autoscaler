#!/usr/bin/env bash
# plan-lint — turn a code spec's completeness into a machine check, instead
# of something a reviewer has to notice by reading closely.
#
#   plan-lint [--dir <conventions-dir>] [--no-conventions] <spec-file>
#
# (the unresolved-judgment flag is added by a later step of the same spec;
# this file grows in place per step.)
#
# Step schema: every `## S<n>` step section must carry all eight fields —
# `**brief**`, `**scope**`, `**do**`, `**conventions**`, `**verify**`,
# `**done_when**`, `**on_fail**`, `**record**` — as a bold marker anywhere in
# its own section (from that heading to the next heading of level 2 or
# shallower, same boundary rule sec.sh uses). The `## Intent` section must
# carry `**intent**`, `**current call stack**`, `**planned call stack**`,
# `**new components**`, `**new conventions**`. And every step section that
# exists must have a matching `**S<n> — ...**` brief inside `## Step index`
# — a step with detail but no brief is invisible to the narrative that a
# coder or reviewer actually reads first.
#
# Clean input produces no output and exits 0. Bad input reports every
# violation, then exits non-zero — never stops at the first, the same
# philosophy conv-lint.sh already established for this worktree's tools.
#
# Convention resolution: a step's `**conventions**` field's value, up to the
# first period, is either the literal `none` or a comma-separated manifest of
# names — the same "`**conventions** — name, other`" shape conv-rename's own
# S3 commit message documents this field as taking. Every cited name is
# resolved against `conv-list.sh --dir <dir>` (default `conventions/`, same
# default conv-list.sh itself uses); an unresolved name is a violation naming
# the step and the name. `none` is valid and passes; an *absent*
# `**conventions**` line, or one present but empty, is a violation — the
# asymmetry is deliberate: omission halts, explicit `none` proceeds.
# --no-conventions skips name resolution (for use before `conventions/`
# exists) but always warns on stderr that it did — silence would look like
# "checked and clean" rather than "not checked". It does not disable the
# absent-vs-none check or the addressing check below, since neither depends
# on `conventions/` existing.
#
# Addressing: no document may reintroduce line-number addressing. Any
# `L<n>:<m>` range or `offset:<n> limit:<m>` occurrence, anywhere in the
# file (not just inside a step), is a violation naming the line.
#
# Exit codes are the contract, and are additive across this spec's steps:
#   0   clean
#   2   usage error
#   3   spec file missing or unreadable
#   20  step schema: a step is missing one or more of the eight fields
#   21  step schema: no Step index section, or a step has no brief in it
#   22  step schema: the Intent block is missing one or more of its five
#       fields (including when the whole ## Intent heading is absent)
#   30  convention resolution: a cited name does not resolve via conv-list.sh
#   31  convention resolution: a step's conventions field is absent or empty
#   32  addressing: a line-number reference survives somewhere in the file
#
# The exit code is the lowest-numbered class present, so a caller can branch
# on the most structural failure while stderr still shows everything else.
set -uo pipefail

die() {
    local code=$1
    shift
    printf 'plan-lint: %s\n' "$*" >&2
    exit "$code"
}

conv_dir=conventions
no_conventions=0
spec=

while [ "$#" -gt 0 ]; do
    case $1 in
        --dir)
            [ "$#" -ge 2 ] || die 2 '--dir needs a directory argument'
            conv_dir=$2
            shift 2
            ;;
        --dir=*)
            conv_dir=${1#--dir=}
            shift
            ;;
        --no-conventions)
            no_conventions=1
            shift
            ;;
        -h|--help)
            printf 'usage: plan-lint [--dir <conventions-dir>] [--no-conventions] <spec-file>\n'
            exit 0
            ;;
        --*)
            die 2 "unknown option: $1"
            ;;
        *)
            [ -z "$spec" ] || die 2 "unexpected argument: $1"
            spec=$1
            shift
            ;;
    esac
done

[ -n "$spec" ] || die 2 'usage: plan-lint [--dir <conventions-dir>] [--no-conventions] <spec-file> (no spec file given)'
[ -f "$spec" ] || die 3 "no such spec file: $spec"
[ -r "$spec" ] || die 3 "spec file is not readable: $spec"

if [ "$no_conventions" -eq 1 ]; then
    printf 'plan-lint: --no-conventions: convention name resolution skipped\n' >&2
fi

# Single parse pass over the whole file, emitting tab-separated records in
# file order — the same shape conv-lint.sh uses, so a reader who already
# knows that script recognises this one.
#
#   STEP           id
#   FIELD          step-id  fieldname
#   INTENT         1
#   INTENTFIELD    fieldname
#   STEPINDEXFOUND 1
#   STEPINDEXBRIEF step-id
#   CONVLINE       step-id  manifest-value (may be empty)
#   LINEREF        lineno   the offending line, verbatim
records=$(awk '
# Addressing is a whole-file property, not step-scoped, and must survive
# every "next" below it — so it runs first and never short-circuits.
$0 ~ /L[0-9]+:[0-9]+/ || $0 ~ /offset:[0-9]+[[:space:]]+limit:[0-9]+/ {
    printf("LINEREF\t%d\t%s\n", NR, $0)
}

/^#+[[:space:]]/ {
    rest = $0
    sub(/^#+/, "", rest)
    level = length($0) - length(rest)
    gsub(/^[[:space:]]+/, "", rest)
    gsub(/[[:space:]]+$/, "", rest)

    # A heading at level 2 or shallower closes any step/Intent/Step-index
    # section currently open — the same same-or-shallower rule sec.sh uses
    # to decide where a section ends.
    if (level <= 2) {
        cur_step = ""
        in_intent = 0
        in_step_index = 0
    }

    if (level == 2 && rest ~ /^S[0-9]+([[:space:]]|$)/) {
        step_id = rest
        sub(/[[:space:]].*/, "", step_id)
        cur_step = step_id
        printf("STEP\t%s\n", step_id)
    } else if (level == 2 && rest == "Intent") {
        in_intent = 1
        printf("INTENT\t1\n")
    } else if (level == 2 && rest == "Step index") {
        in_step_index = 1
        printf("STEPINDEXFOUND\t1\n")
    }
    next
}

cur_step != "" && $0 ~ /^\*\*conventions\*\* — / {
    manifest = $0
    sub(/^\*\*conventions\*\* — /, "", manifest)
    sub(/\..*/, "", manifest)
    gsub(/^[[:space:]]+/, "", manifest)
    gsub(/[[:space:]]+$/, "", manifest)
    printf("CONVLINE\t%s\t%s\n", cur_step, manifest)
    printf("FIELD\t%s\tconventions\n", cur_step)
    next
}

cur_step != "" && $0 ~ /^\*\*(brief|scope|do|conventions|verify|done_when|on_fail|record)\*\*/ {
    field = $0
    sub(/^\*\*/, "", field)
    sub(/\*\*.*/, "", field)
    printf("FIELD\t%s\t%s\n", cur_step, field)
    next
}

in_intent == 1 && $0 ~ /^\*\*(intent|current call stack|planned call stack|new components|new conventions)\*\*/ {
    field = $0
    sub(/^\*\*/, "", field)
    sub(/\*\*.*/, "", field)
    printf("INTENTFIELD\t%s\n", field)
    next
}

in_step_index == 1 && $0 ~ /^\*\*S[0-9]+ — / {
    id = $0
    sub(/^\*\*/, "", id)
    sub(/ .*/, "", id)
    printf("STEPINDEXBRIEF\t%s\n", id)
    next
}
' "$spec")

declare -a step_order=()
declare -A step_seen=()
declare -A field_seen=()
declare -A intent_seen=()
declare -A step_index_brief=()
declare -A conv_manifest=()
declare -a lineref_lines=()
intent_found=0
step_index_found=0

while IFS=$'\t' read -r kind f1 f2; do
    [ -n "$kind" ] || continue
    case $kind in
        STEP)
            if [ -z "${step_seen[$f1]+set}" ]; then
                step_seen[$f1]=1
                step_order+=("$f1")
            fi
            ;;
        FIELD)
            field_seen["$f1|$f2"]=1
            ;;
        INTENT)
            intent_found=1
            ;;
        INTENTFIELD)
            intent_seen[$f1]=1
            ;;
        STEPINDEXFOUND)
            step_index_found=1
            ;;
        STEPINDEXBRIEF)
            step_index_brief[$f1]=1
            ;;
        CONVLINE)
            conv_manifest[$f1]=$f2
            ;;
        LINEREF)
            lineref_lines+=("$spec:$f1: $f2")
            ;;
        *)
            die 2 "internal: unrecognized parse record: $kind"
            ;;
    esac
done <<<"$records"

required_step_fields='brief scope do conventions verify done_when on_fail record'
required_intent_fields=('intent' 'current call stack' 'planned call stack' 'new components' 'new conventions')

report_fields=()
for step in ${step_order+"${step_order[@]}"}; do
    missing=''
    for f in $required_step_fields; do
        [ -n "${field_seen["$step|$f"]+set}" ] || missing="$missing $f"
    done
    [ -z "$missing" ] || report_fields+=("$spec: step $step is missing required field(s):$missing")
done

missing_intent_fields=()
for f in "${required_intent_fields[@]}"; do
    [ -n "${intent_seen[$f]+set}" ] || missing_intent_fields+=("$f")
done
intent_line=()
if [ "${#missing_intent_fields[@]}" -gt 0 ]; then
    joined=$(printf '%s, ' "${missing_intent_fields[@]}")
    joined=${joined%, }
    if [ "$intent_found" -eq 0 ]; then
        intent_line=("$spec: no ## Intent section found (missing: $joined)")
    else
        intent_line=("$spec: ## Intent is missing required field(s): $joined")
    fi
fi

report_stepindex=()
if [ "$step_index_found" -eq 0 ]; then
    report_stepindex+=("$spec: no ## Step index section found")
else
    for step in ${step_order+"${step_order[@]}"}; do
        [ -n "${step_index_brief[$step]+set}" ] || report_stepindex+=("$spec: step $step has no brief in ## Step index")
    done
fi

# Convention resolution and addressing (S5). valid_names is built once,
# only when name resolution is actually going to run — a directory that
# does not exist yet (before --no-conventions is dropped) must not make
# plan-lint itself fail; every citation just reports unresolved instead,
# which is the same "unknown means refuse" outcome by a different route.
declare -A valid_names=()
if [ "$no_conventions" -eq 0 ]; then
    while IFS= read -r rec; do
        [ -n "$rec" ] || continue
        name=${rec%% | *}
        valid_names[$name]=1
    done < <(conv-list.sh --dir "$conv_dir" 2>/dev/null)
fi

report_absent=()
report_unresolved=()
for step in ${step_order+"${step_order[@]}"}; do
    if [ -z "${conv_manifest[$step]+set}" ] || [ -z "${conv_manifest[$step]}" ]; then
        report_absent+=("$spec: step $step has no conventions: declaration (absent, or present but empty)")
        continue
    fi
    manifest=${conv_manifest[$step]}
    # "none" may carry a trailing parenthetical or other prose before the
    # period this manifest was already truncated at (e.g. "none (see §
    # Intent)") — the literal word "none" as the *first* token is what
    # matters, not an exact match on the whole remainder.
    first_token=${manifest%%[^a-z0-9-]*}
    [ "$first_token" = none ] && continue
    [ "$no_conventions" -eq 1 ] && continue
    IFS=',' read -ra cited <<<"$manifest"
    for raw in "${cited[@]}"; do
        name=$raw
        name=${name#"${name%%[![:space:]]*}"}
        name=${name%"${name##*[![:space:]]}"}
        name=${name#\`}
        name=${name%\`}
        # Trailing prose after the name itself (a parenthetical aside, a
        # following clause) is not part of the citation — truncate at the
        # first character outside the charset conv-lint.sh itself validates
        # convention names against ([a-z0-9-]+).
        name=${name%%[^a-z0-9-]*}
        [ -n "$name" ] || continue
        [ -n "${valid_names[$name]+set}" ] || report_unresolved+=("$spec: step $step cites unknown convention: $name")
    done
done

exit_code=0
note_class() {
    local code=$1
    if [ "$exit_code" -eq 0 ] || [ "$code" -lt "$exit_code" ]; then
        exit_code=$code
    fi
}

emit() {
    local code=$1
    shift
    [ "$#" -gt 0 ] || return 0
    local line
    for line in "$@"; do
        printf 'plan-lint: [%d] %s\n' "$code" "$line" >&2
    done
    note_class "$code"
}

emit 20 ${report_fields+"${report_fields[@]}"}
emit 21 ${report_stepindex+"${report_stepindex[@]}"}
emit 22 ${intent_line+"${intent_line[@]}"}
emit 30 ${report_unresolved+"${report_unresolved[@]}"}
emit 31 ${report_absent+"${report_absent[@]}"}
emit 32 ${lineref_lines+"${lineref_lines[@]}"}

exit "$exit_code"
