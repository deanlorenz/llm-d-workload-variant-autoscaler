# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
main
bin/
.vscode/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Kind config file
kind-config.yaml

# Kubernetes manifests
gpu.cluster

# Miscellaneous
.DS_Store
~*

# llm-d and llm-d-infra directories
llm-d/
llm-d-infra/
llm-d-benchmark/

# Local benchmark environment overrides (copy hack/benchmark/.env.sample -> .env)
hack/benchmark/.env
# llmdbenchmark workspace directories (created by benchmark runs)
*-*-*-*-*-*/
biran-*/
# Our own run directories are dean-<date>-<time>-<pid>/, which is only three hyphens and so
# is not matched by the pattern above. Each holds 100+ MB of results and must never be
# committed; the analysis that survives a run lives in session-notes/ instead.
dean-*/
# Harvested copies of run results, kept locally for re-analysis (14-day retention).
session-notes/scratch/ladder-run/
llmd/
llmd-infra/
# Staged image record, moved into the run directory once the run completes.
# Only lingers if a run is interrupted between those two points.
.images-pending.yaml

*.tgz
actionlint

# Generated TLS certificates (auto-created by e2e test setup)
hack/tls-certs/

# AI
.claude/worktrees/
# Per-session tool-permission grants. .claude/agents/ and .claude/skills/ ARE
# tracked project content; settings*.json is local to one operator's session.
.claude/settings.json
.claude/settings.local.json

# Console transcripts of individual benchmark runs (make output). Run-scoped like
# the dean-*/ directories; whatever survives a run belongs in session-notes/.
ta-*-run.log
# Local reference copies from the 2026-06-15 TA3 session, deliberately untracked --
# its own README says so, and the authoritative writeups are in git on
# branch benchmark-ta3-legacy / tag archive/benchmark-ta3-legacy.
reference-legacy/
# Safeguard snapshots of uncommitted state in the llm-d-benchmark fork clone,
# taken before an operation that could lose it. Redundant once the same change is
# committed on the fork's wva-ta-benchmark branch, but harmless to keep locally.
fork-local-uncommitted-*.patch

# Python bytecode from the hack/benchmark and session-notes analysis scripts
__pycache__/

# Scratch working copy of the status file. The Write/Edit tools cannot reach
# plans/session/status/ from inside this worktree (harness isolation blocks the
# shared-checkout path), so edits are made here and copied over with `cp` on save.
# The authoritative copy is plans/session/status/benchmark.md -- this one is a
# transient editing surface and is deliberately untracked, so that a stale copy can
# never be mistaken for state. See session-notes/status/README.md.
session-notes/local/
