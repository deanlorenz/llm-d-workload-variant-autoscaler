# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
main
bin/
.vscode/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Kind config file
kind-config.yaml

# Kubernetes manifests
gpu.cluster

# Miscellaneous
.DS_Store
~*

# llm-d and llm-d-infra directories
llm-d/
llm-d-infra/
llm-d-benchmark/

# Local benchmark environment overrides (copy hack/benchmark/.env.sample -> .env)
hack/benchmark/.env
# llmdbenchmark workspace directories: BENCHMARK_WORKSPACE (Makefile) now
# points the harness CLI's --workspace flag at runs/, so new runs land at
# runs/$USER-<date>-<time>-<pid>/ natively -- no copy, no move, and unlike the
# old repo-root convention below this matches every user's run, not only
# Dean's. See the runs/ rule further down for the config/viz/REPORT.md
# allowlist that applies there.
*-*-*-*-*-*/
biran-*/
# Pre-existing run directories from before BENCHMARK_WORKSPACE moved to runs/
# (2026-08-11) -- dean-<date>-<time>-<pid>/ at the repo root, three hyphens so
# not matched by the glob above. Left in place until migrated or cleaned up;
# still must never be committed.
dean-*/
# Ignore everything the harness writes under a run directory (results/, logs/,
# setup/, plan/, environment/ -- 100+ MB of scrapes and per-stage summaries per
# run) EXCEPT the reproducible/durable set that run_cell.sh copies alongside
# it: config/ (the .env used, analyzer config, image record, ScaledObject
# snapshot), viz/ (panels/coverage/bundle), and REPORT.md. Git requires each
# ancestor directory re-included explicitly -- a `!` pattern cannot resurrect a
# path whose parent is still excluded.
runs/*/*
!runs/*/config/
!runs/*/config/**
!runs/*/viz/
!runs/*/viz/**
!runs/*/REPORT.md
# Harvested copies of run results, kept locally for re-analysis (14-day retention).
session-notes/scratch/ladder-run/
llmd/
llmd-infra/
# Staged image record, moved into the run directory once the run completes.
# Only lingers if a run is interrupted between those two points.
.images-pending.yaml

*.tgz
actionlint

# Generated TLS certificates (auto-created by e2e test setup)
hack/tls-certs/

# AI
.claude/worktrees/
# Per-session tool-permission grants. .claude/agents/ and .claude/skills/ ARE
# tracked project content; settings*.json is local to one operator's session.
.claude/settings.json
.claude/settings.local.json

# Console transcripts of individual benchmark runs (make output). Run-scoped like
# the dean-*/ directories; whatever survives a run belongs in session-notes/.
ta-*-run.log
# Local reference copies from the 2026-06-15 TA3 session, deliberately untracked --
# its own README says so, and the authoritative writeups are in git on
# branch benchmark-ta3-legacy / tag archive/benchmark-ta3-legacy.
reference-legacy/
# Safeguard snapshots of uncommitted state in the llm-d-benchmark fork clone,
# taken before an operation that could lose it. Redundant once the same change is
# committed on the fork's wva-ta-benchmark branch, but harmless to keep locally.
fork-local-uncommitted-*.patch

# Python bytecode from the hack/benchmark and session-notes analysis scripts
__pycache__/

# Per-cell artifacts from hack/benchmark/campaign/run_all.sh: raw controller logs,
# run logs, recorded config. Run-scoped and large, like the dean-*/ directories --
# whatever is worth keeping from a campaign gets copied out deliberately (the
# analysis that survives a run belongs in session-notes/ proper).
session-notes/campaign-runs/

# Scratch working copy of the status file. The Write/Edit tools cannot reach
# plans/session/status/ from inside this worktree (harness isolation blocks the
# shared-checkout path), so edits are made here and copied over with `cp` on save.
# The authoritative copy is plans/session/status/benchmark.md -- this one is a
# transient editing surface and is deliberately untracked, so that a stale copy can
# never be mistaken for state. See session-notes/status/README.md.
session-notes/local/
